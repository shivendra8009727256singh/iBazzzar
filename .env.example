# Copy to .env at project root. Demo data is ephemeral and never production.
APP_MODE=demo
WEB_ORIGIN=http://127.0.0.1:3000
PORT=4000
# Where the Next.js server reaches the API (also baked into /api rewrites at build time).
API_ORIGIN=http://127.0.0.1:4000
# Only configure a NEW dedicated IBazzzar database (UTF-8 encoding).
DATABASE_URL=postgresql://ibazzzar:replace_me@127.0.0.1:5433/ibazzzar_dev
REDIS_URL=redis://127.0.0.1:6380
# Test keys only. Live mode is deliberately disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Non-production only: the first account registered with this email becomes ADMIN.
# In database mode use `node scripts/grant-admin.mjs <email>` instead.
BOOTSTRAP_ADMIN_EMAIL=
# Worker: minutes an unpaid order keeps its reserved stock before it is cancelled.
PAYMENT_WINDOW_MINUTES=30
