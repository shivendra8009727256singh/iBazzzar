# IBazzzar configuration. Copy to .env at the project root and fill in. Never commit .env.

NODE_ENV=development
# Public URL of the website (browser origin). Must be https in production.
WEB_ORIGIN=http://127.0.0.1:3000
# API listen address. Behind a reverse proxy, keep HOST=127.0.0.1 and set TRUST_PROXY=1.
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=0
# Where the Next.js server reaches the API (used for /api rewrites and server rendering).
API_ORIGIN=http://127.0.0.1:4000

# PostgreSQL — a dedicated, UTF-8 IBazzzar database. Only this URL is needed.
# Local (npm run dev starts it):  postgresql://ibazzzar:ibazzzar_local_dev@127.0.0.1:5544/ibazzzar
# Managed (Aiven, Neon, RDS …):   paste the provider's URL; ?sslmode=require encrypts the connection,
#                                 ?sslmode=verify-full also checks the certificate (it must be trusted here).
DATABASE_URL=postgresql://ibazzzar:ibazzzar_local_dev@127.0.0.1:5544/ibazzzar

# Redis — shared rate limits and the background worker queue.
REDIS_URL=redis://127.0.0.1:6380

# 32-byte key (64 hex characters) that encrypts seller bank account numbers. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Payments. Only Razorpay TEST keys (rzp_test_…) are accepted until live payments are approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local demos only: lets you simulate a successful payment when Razorpay is not configured. Refused in production.
DEMO_PAYMENTS=true

# Email: console (development — links are printed in the API log), smtp, or none.
MAIL_PROVIDER=console
MAIL_FROM=IBazzzar <no-reply@ibazzzar.com>
# smtp://user:password@smtp.example.com:587
SMTP_URL=

# Media storage: local (development) or s3 (any S3-compatible bucket).
STORAGE_DRIVER=local
MEDIA_DIR=.local/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/CDN base URL for the bucket, e.g. https://media.ibazzzar.com
S3_PUBLIC_URL=

# Admin — created only by `npm run admin:create` (scripts/create-admin.mjs), never by registration.
# Signs in at /admin/login. Use a long random password and keep .env out of git.
ADMIN_NAME=IBazzzar Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=info
