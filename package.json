{
  "name": "ibazzzar",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w @ibazzzar/api\" \"npm run dev -w @ibazzzar/web\"",
    "build": "npm run build -w @ibazzzar/web",
    "test": "node scripts/test.mjs",
    "typecheck": "npm run typecheck -w @ibazzzar/web",
    "lint": "eslint .",
    "db:generate": "npm run db:generate -w @ibazzzar/api",
    "db:migrate": "npm run db:migrate -w @ibazzzar/api",
    "worker": "npm run start -w @ibazzzar/worker",
    "check": "npm run lint && npm test && npm run typecheck && npm run build",
    "db:seed": "npm run db:seed -w @ibazzzar/api",
    "db:seed:demo": "npm run db:seed -w @ibazzzar/api -- --demo",
    "dev:db": "node scripts/dev-db.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "superadmin": "node scripts/create-superadmin.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
